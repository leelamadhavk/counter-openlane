digraph "counter" {
label="counter";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="clk", color="black", fontcolor="black"];
n3 [ shape=octagon, label="count", color="black", fontcolor="black"];
n4 [ shape=octagon, label="rst", color="black", fontcolor="black"];
v0 [ label="1" ];
c8 [ shape=record, label="{{<p5> A|<p6> B}|$2\n$add|{<p7> Y}}",  ];
c13 [ shape=record, label="{{<p9> CLK|<p10> D|<p11> SRST}|$7\n$sdff|{<p12> Q}}",  ];
x1 [ shape=record, style=rounded, label="<s0> 3:0 - 3:0 ", color="black", fontcolor="black" ];
x1:e -> c13:p10:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c8:p7:e -> x1:s0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c13:p9:w [color="black", fontcolor="black", label=""];
c13:p12:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c8:p5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c13:p11:w [color="black", fontcolor="black", label=""];
v0:e -> c8:p6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
